PORT=3000

DATABASE_URL_LOCAL=./data/sqlite.db
DATABASE_URL_FLY=/data/sqlite.db

# Bug mode (default: healthy)
APP_MODE=healthy

# Enable admin APIendpoints
ADMIN_TOKEN=<your-token-here>

# Flaky endpoint: number of failures before success
FLAKY_FAILS=2

# Seed controls for containers

# seeds if db doesn't exist 
SEED_ON_START=1
# reseeds every run 
FORCE_SEED=0
